# ---------------------------------------------------------------------------
# Condor submit: MET-trigger skim, ONE cluster per samplelist .txt, ONE job per
# BATCH-sized slice of ROOT files. ProcId selects the slice; each job skims up to
# BATCH files to <OUTDIR>/<txtstem>/<txtstem>_<rootid>.root.
#
# This file is submitted once per .txt by condorJobs/met_trigger/submit_all.sh,
# which passes KIND / TXTFILE / BATCH / NJOBS so each .txt becomes its own
# ClusterId (NJOBS = ceil(NFILES/BATCH) jobs; e.g. 594 files / 50 -> 12 jobs).
#
# Vars passed by submit_all.sh via -append (do not hardcode here):
#   KIND, TXTFILE, BATCH, NJOBS
#
# Static vars below use $(USER_INITIAL)/$ENV(USER) so they resolve to YOUR paths
# with no editing — only change them if your checkout / output / proxy live
# somewhere other than the standard CERN AFS+EOS home layout:
#   REPO_DIR   : this DarkBottomLine checkout (default: AFS home/DarkBottomLine)
#   CONFIG     : year YAML (any era), e.g. configs/2024.yaml
#   OUTDIR     : where skim ROOTs land (job-visible: AFS/EOS)
#   Proxy_path : AFS path to your x509 proxy (create it first, see README);
#                must be a FULL resolved AFS path (NOT $HOME / ~ / /eos).
# ---------------------------------------------------------------------------

REPO_DIR = /CHANGE/ME/DarkBottomLine
CONFIG   = configs/2024.yaml
OUTDIR   = /CHANGE/ME/met_trigger_skims/2024

# x509 proxy: shipped into the job sandbox and used for XRootD reads.
# The AFS path is built from your username: /afs/cern.ch/user/<initial>/<user>/private/.
Proxy_filename = x509up_u$(id -u)
Proxy_path     = /afs/cern.ch/user/$(USER_INITIAL)/$ENV(USER)/private/$(Proxy_filename)

executable            = condorJobs/met_trigger/run_skim.sh
# Args: proxy filename, repo, config, outdir, kind, txtfile, ProcId, batch size.
arguments             = $(Proxy_filename) $(REPO_DIR) $(CONFIG) $(OUTDIR) $(KIND) $(TXTFILE) $(ProcId) $(BATCH)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = ""
transfer_input_files  = $(Proxy_path)

# LOGDIR is the absolute ${SUBDIR}/logs passed (and created) by submit_all.sh.
output                = $(LOGDIR)/skim_$(ClusterId)_$(ProcId).out
error                 = $(LOGDIR)/skim_$(ClusterId)_$(ProcId).err
log                   = $(LOGDIR)/skim_$(ClusterId).log

# Resources — up to BATCH files per job, skimmed sequentially (one at a time in
# memory). ~50 files x ~30s ~= 25 min/job; workday (8h) has ample headroom.
request_memory = 4000
request_cpus = 1
+JobFlavour           = "workday"

# Hold on failure; retry every 10 min up to 3 starts.
on_exit_hold     = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)

# NJOBS jobs (ProcId 0 .. NJOBS-1), each a BATCH-sized slice of TXTFILE.
queue $(NJOBS)
