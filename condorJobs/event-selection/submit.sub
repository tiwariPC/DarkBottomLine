# ---------------------------------------------------------------------------
# Condor submit: event selection (NanoAOD -> EVENTSELECTION.root), ONE cluster
# per samplelist .txt, ONE job per slice of ROOT files. Each job runs its files
# sequentially (one `darkbottomline analyze --mode event-selection` per file),
# writes to worker scratch and xrdcp's each output to EOS:
#   <OUTDIR>/<YEAR>/eventsel/<sample>/<sample>_I<fileIdx>C<ClusterId>P<ProcId>_EVENTSELECTION.root
#
# Submitted once per .txt by submit_samples.py, which passes every variable
# below via -append (do not hardcode here). SLICEFILE has one line per job:
#   <SLICE_ID> <idx>:<idx>:...      (0-based file indices into the .txt)
# so regular batching and "only missing files" resubmission share one path.
#
# Vars from submit_samples.py:
#   EXEC, REPO_DIR, CONFIG, YEAR, SAMPLE_TXT, OUTDIR, IS_DATA, WORKERS,
#   CHUNK_SIZE, MAX_EVENTS, PROXY_PATH, PROXY_FILE, LOGDIR, BATCH_NAME,
#   CPUS, MEMORY, FLAVOUR, SLICEFILE
# ---------------------------------------------------------------------------

universe   = vanilla
executable = $(EXEC)
arguments  = $(PROXY_FILE) $(INDICES)

environment = "DBL_REPO_DIR=$(REPO_DIR) DBL_CONFIG=$(CONFIG) DBL_YEAR=$(YEAR) DBL_SAMPLE_TXT=$(SAMPLE_TXT) DBL_OUTDIR=$(OUTDIR) DBL_DATA=$(IS_DATA) DBL_WORKERS=$(WORKERS) DBL_CHUNK_SIZE=$(CHUNK_SIZE) DBL_MAX_EVENTS=$(MAX_EVENTS) DBL_SLICE_ID=$(SLICE_ID)"

# x509 proxy shipped into the sandbox for XRootD reads. EOS writes use the
# Kerberos credentials HTCondor forwards at CERN.
use_x509userproxy       = true
x509userproxy           = $(PROXY_PATH)
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
transfer_output_files   = ""

output = $(LOGDIR)/output/$(BATCH_NAME).$(ClusterId).$(SLICE_ID).out
error  = $(LOGDIR)/error/$(BATCH_NAME).$(ClusterId).$(SLICE_ID).err
log    = $(LOGDIR)/$(BATCH_NAME).$(ClusterId).log

batch_name     = $(BATCH_NAME)
MY.WantOS      = "el9"
request_cpus   = $(CPUS)
request_memory = $(MEMORY)
+JobFlavour    = "$(FLAVOUR)"

# Hold on failure (any file in the slice failed, or killed by a signal); release
# after 10 min, up to 3 starts. Files already on EOS are skipped on restart, so a
# retry only redoes the failed ones. After 3 starts the job is removed — rerun
# submit_samples.py (it only submits files still missing on EOS).
on_exit_hold     = (ExitBySignal == True) || (ExitCode != 0)
periodic_release = (NumJobStarts < 3) && ((time() - EnteredCurrentStatus) > 600)
periodic_remove  = (JobStatus == 5) && (NumJobStarts >= 3)

queue SLICE_ID, INDICES from $(SLICEFILE)
