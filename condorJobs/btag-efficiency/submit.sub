universe = vanilla
use_x509userproxy = true
x509userproxy = /afs/cern.ch/user/u/username/private/x509up_u98885

executable = runanalysis.sh
arguments = $(ProcId)

output  = logs/output/dbl.$(ClusterId).$(ProcId).out
error   = logs/error/dbl.$(ClusterId).$(ProcId).err
log     = logs/dbl.$(ClusterId).log

# Send the job to Held state on failure.
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

# Periodically retry the jobs every 10 minutes, up to a maximum of 3 retries.
periodic_release =  (NumJobStarts < 3) && ((CurrentTime - EnteredCurrentStatus) > 600)

# Resource requests
request_memory = 4000
request_cpus = 1
+JobFlavour = "testmatch"

# Template submit file - edit DBL_REPO_DIR/DBL_CONFIG/DBL_BKG_FILE/DBL_YEAR
# below, or generate a copy per sample the same way submit_samples.py does
# for condorJobs/event-selection/.
#
# queue N (N = number of files in DBL_BKG_FILE) fans out one job per input
# file via $(ProcId) indexing the sample list, same pattern as event-selection.

environment = "DBL_REPO_DIR=/path/to/repository \
DBL_CONFIG=\$(DBL_REPO_DIR)/configs/2024.yaml \
DBL_BKG_FILE=TTto2L2Nu_TuneCP5_13p6TeV_powheg-pythia8.txt \
DBL_YEAR=2024 \
DBL_MAX_EVENTS="

queue 1
